#!/usr/bin/env bash
# lgit: list, create and clone bare git repos on a hub reached over SSH, and
# install the CI/CD hook into them. Runs on a client; the hub needs only sshd and git.
#
# Config: ~/.config/lgit/config (shell syntax), overridden by the environment:
#   LGIT_HOST   ssh host of the hub (required)
#   LGIT_USER   ssh user on the hub (default: whatever ssh uses for that host)
#   LGIT_ROOT   folder of <name>.git bare repos on the hub (default /srv/git)
set -euo pipefail

# Environment wins over the config file.
env_host=${LGIT_HOST-} env_user=${LGIT_USER-} env_root=${LGIT_ROOT-}
cfg=${XDG_CONFIG_HOME:-$HOME/.config}/lgit/config
[[ -f $cfg ]] && . "$cfg"
HOST=${env_host:-${LGIT_HOST:-}}
HUB_USER=${env_user:-${LGIT_USER:-}}
ROOT=${env_root:-${LGIT_ROOT:-/srv/git}}
SSH=${HUB_USER:+$HUB_USER@}$HOST              # what ssh and git remotes use: [user@]host

HOOK=$(dirname "$(readlink -f "$0")")/../hooks/post-receive   # follows a ~/.local/bin symlink

die() { echo "lgit: $1" >&2; exit "${2:-1}"; }
# Names go into remote shell commands, so allow only safe characters.
check_name() { [[ ${1:-} =~ ^[A-Za-z0-9._-]+$ && $1 != *.git ]] || die "bad repo name: ${1:-}" 2; }
need_host() { [[ -n $HOST ]] || die "no hub configured: set LGIT_HOST in $cfg or the environment" 2; }

case ${1:-} in
  ls)    # name, size and default branch of every repo on the hub
    need_host
    ssh "$SSH" "cd $ROOT && for r in *.git; do [ -d \"\$r\" ] || continue
      printf '%-24s %6s  %s\n' \"\${r%.git}\" \"\$(du -sh \"\$r\" | cut -f1)\" \"\$(git -C \"\$r\" symbolic-ref --short HEAD)\"; done" ;;

  new)   # create an empty bare repo (fails if it exists), then show how to connect to it
    need_host; check_name "${2:-}"
    ssh "$SSH" "test ! -e $ROOT/$2.git && git init -q --bare -b main $ROOT/$2.git" \
      || die "$SSH:$ROOT/$2.git already exists or could not be created"
    echo "created $SSH:$ROOT/$2.git"
    echo "connect: git remote add hub $SSH:$ROOT/$2.git && git push -u hub main" ;;

  clone) # clone with the remote named 'hub', leaving 'origin' free for e.g. GitHub
    need_host; check_name "${2:-}"
    git clone -o hub "$SSH:$ROOT/$2.git" ${3:+"$3"} ;;

  ci)    # install or update the CI/CD hook in a hub repo
    need_host; check_name "${2:-}"
    ssh "$SSH" "test -d $ROOT/$2.git && cat > $ROOT/$2.git/hooks/post-receive && chmod +x $ROOT/$2.git/hooks/post-receive" <"$HOOK" \
      || die "no repo $SSH:$ROOT/$2.git"
    echo "ci hook installed in $SSH:$ROOT/$2.git" ;;

  log)   # recent CI runs, then the log of the latest run (or of the given commit)
    need_host; check_name "${2:-}"
    [[ -z ${3:-} || $3 =~ ^[0-9a-f]+$ ]] || die "bad commit: $3" 2
    ssh "$SSH" "cd $ROOT/$2.git/ci 2>/dev/null || { echo 'no CI runs yet'; exit 1; }
      tail -n 10 runs 2>/dev/null; echo
      f=\$(ls -t ${3:-}*.log 2>/dev/null | head -1); [ -n \"\$f\" ] && cat \"\$f\" || echo 'no log yet'" ;;

  *)
    echo "usage: lgit ls | new <name> | clone <name> [dir] | ci <name> | log <name> [commit]"
    if [[ -n $HOST ]]; then echo "hub:   $SSH:$ROOT"; else echo "hub:   not configured (set LGIT_HOST in $cfg)"; fi
    [[ -z ${1:-} || $1 == -h || $1 == --help || $1 == help ]] || exit 2 ;;
esac
